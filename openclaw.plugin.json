{
  "id": "personal-gtd",
  "name": "Personal GTD",
  "description": "Collect explicit Feishu instructions into Apple Reminders Inbox.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "accountId": {
        "type": "string",
        "minLength": 1
      },
      "entryAgentId": {
        "type": "string",
        "minLength": 1
      },
      "allowedSenderIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^ou_[A-Za-z0-9_-]+$"
        }
      },
      "allowedConversationIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^oc_[A-Za-z0-9_-]+$"
        }
      },
      "activation": {
        "type": "string",
        "minLength": 1,
        "default": "小婕 GTD"
      },
      "stateDir": {
        "type": "string",
        "pattern": "^/"
      },
      "runtimeConfigPath": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ]
        },
        "then": {
          "required": [
            "accountId",
            "entryAgentId",
            "allowedSenderIds",
            "allowedConversationIds",
            "stateDir",
            "runtimeConfigPath"
          ]
        }
      }
    ]
  }
}
